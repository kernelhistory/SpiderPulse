<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Global policy: block cleartext HTTP traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Exception strictly for ip-api.com free keyless geolocation endpoint (HTTP-only tier) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
